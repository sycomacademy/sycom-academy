{
  "name": "@sycom-learn/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./schema/*": {
      "default": "./src/schema/*.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate && bun run src/sql/apply.ts",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate && bun run src/sql/apply.ts",
    "db:apply-sql": "bun run src/sql/apply.ts",
    "db:verify": "bun run src/sql/verify.ts"
  },
  "dependencies": {
    "@sycom-learn/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sycom-learn/config": "workspace:*",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
