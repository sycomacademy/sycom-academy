{
  "name": "sycom-learn",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^22.20.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "tailwindcss": "^4.3.3",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "better-auth": "1.6.27",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "react-hook-form": "^7.75.0",
      "@hookform/resolvers": "^5.2.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:dashboard": "turbo run dev -F dashboard --",
    "db:push": "turbo run db:push -F @sycom-learn/db --",
    "db:studio": "turbo run db:studio -F @sycom-learn/db --",
    "db:generate": "turbo run db:generate -F @sycom-learn/db --",
    "db:migrate": "turbo run db:migrate -F @sycom-learn/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "vm:up": "./scripts/access-vm.sh up",
    "vm:down": "./scripts/access-vm.sh down",
    "vm:status": "./scripts/access-vm.sh status",
    "db:token": "./scripts/db-token.sh",
    "db:password": "./scripts/db-password.sh",
    "check": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "@sycom-learn/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sycom-learn/config": "workspace:*",
    "@types/node": "^22.20.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.12",
  "trustedDependencies": [
    "lefthook"
  ]
}
