{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX=sycomacademy}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "postgresAdminLogin": {
      "value": "${POSTGRES_ADMIN_LOGIN=sycomadmin}"
    },
    "postgresAdminPassword": {
      "value": "${POSTGRES_ADMIN_PASSWORD}"
    },
    "betterAuthSecret": {
      "value": "${BETTER_AUTH_SECRET}"
    },
    "developerPrincipalName": {
      "value": "${AZURE_PRINCIPAL_NAME=}"
    },
    "githubRepository": {
      "value": "${GITHUB_REPOSITORY=sycomacademy/sycom-academy}"
    },
    "githubBranch": {
      "value": "${GITHUB_BRANCH=main}"
    },
    "accessVmShutdownNotificationEmail": {
      "value": "${ACCESS_VM_SHUTDOWN_EMAIL=}"
    },
    "containerImageName": {
      "value": "${SERVICE_DASHBOARD_IMAGE_NAME=}"
    }
  }
}
